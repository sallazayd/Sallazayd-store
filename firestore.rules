rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Products: anyone can read (storefront), only signed-in admin can write
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Orders: anyone can create (checkout), only signed-in admin can read/update/delete
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Settings: anyone can read (storefront header/logo), only signed-in admin can write
    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
